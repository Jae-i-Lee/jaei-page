# GitHub OAuth (login only)
STUDIO_GITHUB_CLIENT_ID=
STUDIO_GITHUB_CLIENT_SECRET=
STUDIO_GITHUB_USERNAME=Jae-i-Lee

# 32 characters or longer. Generate a random value; never commit the real one.
STUDIO_SESSION_SECRET=

# Use the stable Vercel production alias for the private Studio login.
STUDIO_BASE_URL=https://jaei-page.vercel.app

# Supabase blog database (server only)
SUPABASE_URL=
# Create a secret key (sb_secret_...) in Supabase Settings > API Keys.
SUPABASE_SECRET_KEY=

# Vercel Deploy Hook: rebuilds the static blog after publishing
STUDIO_VERCEL_DEPLOY_HOOK_URL=

# Vercel Web Analytics API
STUDIO_VERCEL_TOKEN=
STUDIO_VERCEL_PROJECT_ID=
# Leave empty for a personal-account project.
STUDIO_VERCEL_TEAM_ID=
