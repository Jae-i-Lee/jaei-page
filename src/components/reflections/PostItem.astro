---
import Tags from "@/components/ui/Tags.astro";
import { type CollectionEntry } from "astro:content";

export interface Props {
  post: CollectionEntry<"reflections">;
}

const { post } = Astro.props;

const visibleTags = (post.data.tags ?? []).filter(
  (tag) => tag.toLowerCase() !== "reflections",
);

const formattedDate = post.data.pubDate
  .toLocaleDateString("ko-KR", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    timeZone: "UTC",
  })
  .replace(/\.$/, "");
---

<article class="reveal border-b border-border py-8 first:pt-0 last:border-b-0">
  <div class="grid gap-3 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-6">
    <time
      datetime={post.data.pubDate.toISOString()}
      class="pt-1 text-xs font-medium text-muted-foreground sm:text-sm"
    >
      {formattedDate}
    </time>

    <div>
      <a href={`/${post.collection}/${post.id}`} class="group/link block">
        <h2
          class="text-xl font-medium tracking-tight text-foreground transition-colors group-hover/link:text-primary sm:text-2xl"
        >
          {post.data.title}
        </h2>

        {
          post.data.description && (
            <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-muted-foreground sm:text-base">
              {post.data.description}
            </p>
          )
        }
      </a>

      {visibleTags.length > 0 && <Tags tags={visibleTags} class="mt-4" />}
    </div>
  </div>
</article>
