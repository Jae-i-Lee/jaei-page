---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import Headline from "@/components/ui/Headline.astro";
import Pagination from "@/components/ui/Pagination.astro";
import PostItem from "@/components/psychology/PostItem.astro";
import type { GetStaticPathsOptions } from "astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const psychologyEntries = await getCollection("psychology");
  const sortedPosts = psychologyEntries
    .filter((post) => post.data && post.data.pubDate)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return paginate(sortedPosts, { pageSize: 6 });
}

const { page } = Astro.props;
const psychology = page.data;

const metadata = {
  title: "Psychology",
  description: "사람을 공부하고, 행복하게 살아갈 방법을 연구합니다.",
};
---

<BaseLayout metadata={metadata}>
  <section class="px-6 py-16 sm:px-8 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <Headline
        tagline="Psychology"
        title="조금 덜 괴롭게"
        subtitle="사람을 공부하고, 행복하게 살아갈 방법을 연구합니다."
        classes={{
          container: "reveal mb-16 border-l border-border pl-6 sm:pl-8",
          title:
            "mb-4 font-serif text-3xl font-normal tracking-tight text-foreground md:text-4xl",
          subtitle:
            "max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg",
          tagline: "px-0 py-0 text-xs uppercase tracking-[0.2em]",
        }}
        titleAs="h1"
      />

      <div>
        {psychology.map((post) => <PostItem post={post} />)}
      </div>
      <Pagination page={page} />
    </div>
  </section>
</BaseLayout>
