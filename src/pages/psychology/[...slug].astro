---
import DatabasePostArticle from "@/components/blog/DatabasePostArticle.astro";
import { listPublishedPosts, renderPostMarkdown } from "@/lib/blog";

export async function getStaticPaths() {
  const posts = await listPublishedPosts("psychology");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const html = renderPostMarkdown(post.body);
---

<DatabasePostArticle {post} {html} />
