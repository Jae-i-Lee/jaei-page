---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import Headline from "@/components/ui/Headline.astro";
import PostItem from "@/components/psychology/PostItem.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("psychology");
  const posts = allPosts.filter((post) => post.data && post.data.pubDate); // Ensure published

  const categories = new Set();
  posts.forEach((post) => {
    if (post.data.category) {
      categories.add(post.data.category);
    }
  });

  return Array.from(categories).map((category) => {
    return {
      params: { category: category as string },
      props: {
        category,
        posts: posts.filter((post) => post.data.category === category),
      },
    };
  });
}

const { category, posts } = Astro.props;

const metadata = {
  title: `${category} · Psychology`,
  description: `${category} 분류의 심리학 글을 모았습니다.`,
};
---

<BaseLayout metadata={metadata}>
  <section class="px-6 py-16 sm:px-8 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <Headline
        tagline="Category"
        title={category}
        subtitle={`${posts.length}개의 글`}
        classes={{
          container: "mb-12 border-l border-border pl-6 sm:pl-8",
          title:
            "mb-4 font-serif text-3xl font-normal tracking-tight text-foreground md:text-4xl",
          subtitle: "text-base text-muted-foreground",
          tagline: "px-0 py-0 text-xs uppercase tracking-[0.2em]",
        }}
        titleAs="h1"
      />

      <div class="mb-10">
        <a
          href="/psychology"
          class="text-sm font-medium text-primary transition-opacity hover:opacity-70"
          >← Psychology로 돌아가기</a
        >
      </div>

      <div>
        {
          posts
            .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
            .map((post) => <PostItem post={post} />)
        }
      </div>
    </div>
  </section>
</BaseLayout>
