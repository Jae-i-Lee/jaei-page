---
import BaseLayout from "@/layouts/BaseLayout.astro";

const metadata = {
  title: "페이지를 찾을 수 없습니다",
  description: "요청한 페이지가 존재하지 않거나 주소가 변경되었습니다.",
};
---

<BaseLayout {metadata}>
  <section
    class="mx-auto flex min-h-[60vh] max-w-3xl items-center px-6 py-20 sm:px-8"
  >
    <div class="border-l border-border pl-6 sm:pl-8">
      <p
        class="mb-5 text-xs font-semibold uppercase tracking-[0.24em] text-muted-foreground"
      >
        404
      </p>
      <h1
        class="font-serif text-3xl font-normal tracking-tight text-foreground sm:text-4xl"
      >
        페이지를 찾을 수 없습니다.
      </h1>
      <p class="mt-5 text-base leading-relaxed text-muted-foreground">
        주소가 바뀌었거나 삭제된 페이지일 수 있습니다.
      </p>
      <a
        href="/"
        class="mt-9 inline-flex items-center text-sm font-medium text-primary transition-opacity hover:opacity-70"
      >
        홈으로 돌아가기 <span aria-hidden="true" class="ml-2">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
