---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { listPublishedPosts } from "@/lib/blog";
import Headline from "@/components/ui/Headline.astro";
import PostItem from "@/components/blog/DatabasePostItem.astro";

export async function getStaticPaths() {
  const posts = await listPublishedPosts("reflections");

  const tags = new Set();
  posts.forEach((post) => {
    post.tags.forEach((tag) => tags.add(tag));
  });

  return Array.from(tags).map((tag) => {
    return {
      params: { tag: tag as string },
      props: {
        tag,
        posts: posts.filter((post) => post.tags.includes(tag as string)),
      },
    };
  });
}

const { tag, posts } = Astro.props;

const metadata = {
  title: `#${tag} · Reflections`,
  description: `${tag} 태그가 붙은 기록을 모았습니다.`,
};
---

<BaseLayout metadata={metadata}>
  <section class="px-6 py-16 sm:px-8 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <Headline
        tagline="Tag"
        title={`#${tag}`}
        subtitle={`${posts.length}개의 글`}
        classes={{
          container: "mb-12 border-l border-border pl-6 sm:pl-8",
          title:
            "mb-4 font-sans text-3xl font-bold tracking-tight text-foreground md:text-4xl",
          subtitle: "text-base text-muted-foreground",
          tagline: "px-0 py-0 text-xs uppercase tracking-[0.2em]",
        }}
        titleAs="h1"
      />

      <div class="mb-10">
        <a
          href="/reflections"
          class="text-sm text-primary transition-opacity hover:opacity-70"
          >← Reflections로 돌아가기</a
        >
      </div>

      <div>
        {
          posts
            .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf())
            .map((post) => <PostItem post={post} />)
        }
      </div>
    </div>
  </section>
</BaseLayout>
