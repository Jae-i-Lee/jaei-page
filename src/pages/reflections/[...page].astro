---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import Headline from "@/components/ui/Headline.astro";
import Pagination from "@/components/ui/Pagination.astro";
import PostItem from "@/components/reflections/PostItem.astro";
import type { GetStaticPathsOptions } from "astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const reflectionsEntries = await getCollection("reflections");
  const sortedPosts = reflectionsEntries
    .filter((post) => post.data && post.data.pubDate)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return paginate(sortedPosts, { pageSize: 6 });
}

const { page } = Astro.props;
const reflections = page.data;

const metadata = {
  title: "Reflections",
  description: "지나갔지만 여전히 마음에 남아 있는 것들을 적습니다.",
};
---

<BaseLayout metadata={metadata}>
  <section class="px-6 py-16 sm:px-8 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <Headline
        tagline="Reflections"
        title="지나간 것들"
        subtitle="여전히 마음에 남아 있는 것들을 적습니다."
        classes={{
          container: "reveal mb-16 border-l border-border pl-6 sm:pl-8",
          title:
            "mb-4 font-sans text-3xl font-bold tracking-tight text-foreground md:text-4xl",
          subtitle:
            "max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg",
          tagline: "px-0 py-0 text-xs uppercase tracking-[0.2em]",
        }}
        titleAs="h1"
      />

      <div>
        {reflections.map((post) => <PostItem post={post} />)}
      </div>
      <Pagination page={page} />
    </div>
  </section>
</BaseLayout>
