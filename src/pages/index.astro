---
import Layout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---

<Layout title="Nero">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-24">
    {/* 자기소개 영역 */}
    <header class="mb-16">
      <h1 class="text-3xl font-bold mb-4 font-sans tracking-tight">Nero</h1>
      <p class="text-gray-600 dark:text-gray-400 font-serif leading-relaxed">
        사색과 일상을 기록하는 공간입니다. 군더더기 없는 문장으로 생각을 정리합니다.
      </p>
    </header>

    {/* 에세이 리스트 영역 */}
    <main>
      <ul class="space-y-10">
        {sortedPosts.map((post) => (
          <li>
            <a href={`/blog/${post.slug || post.id}`} class="block group">
              <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 group-hover:text-gray-500 dark:group-hover:text-gray-400 transition-colors duration-200 font-sans tracking-tight">
                {post.data.title}
              </h3>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-2 font-sans">
                {new Date(post.data.pubDate).toLocaleDateString('ko-KR')}
              </p>
              <p class="text-gray-700 dark:text-gray-300 mt-3 font-serif leading-relaxed text-sm">
                {post.data.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </section>
</Layout>