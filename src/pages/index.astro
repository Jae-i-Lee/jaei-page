---
import Layout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
---

<Layout title="jaei.page">
  <section class="max-w-3xl mx-auto px-6 sm:px-8 py-20 sm:py-28">
    
    {/* 시그니처 메시지 영역 */}
    <header class="mb-24 text-left">
      <p class="text-xl sm:text-2xl font-serif text-gray-700 dark:text-gray-300 leading-relaxed tracking-wide">
        "우리는 종종 정답을 찾으려 밤을 헤매지만, <br class="hidden sm:block"/>때로는 좋은 질문 하나를 남기는 것만으로도 충분한 밤이 있습니다."
      </p>
    </header>

    {/* 에세이 리스트 영역 */}
    <main>
      <h2 class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-8">
        Recent Writings
      </h2>
      <ul class="space-y-12">
        {sortedPosts.map((post) => (
          <li class="group">
            <a href={`/blog/${post.slug || post.id}`} class="block flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-6">
              <time class="text-sm font-sans text-gray-400 dark:text-gray-500 shrink-0 sm:w-28">
                {new Date(post.data.pubDate).toLocaleDateString('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\.$/, '')}
              </time>
              <div class="space-y-2">
                <h3 class="text-lg sm:text-xl font-medium text-gray-800 dark:text-gray-200 group-hover:text-black dark:group-hover:text-white transition-colors duration-200 font-sans tracking-tight">
                  {post.data.title}
                </h3>
                <p class="text-gray-500 dark:text-gray-400 font-serif leading-relaxed text-sm sm:text-base line-clamp-2">
                  {post.data.description}
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </main>

  </section>
</Layout>
