---
import Layout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const psychologyPosts = (await getCollection('psychology')).map((post) => ({
  ...post,
  collectionName: 'psychology',
}));

const philosophyPosts = (await getCollection('philosophy')).map((post) => ({
  ...post,
  collectionName: 'philosophy',
}));

const reflectionsPosts = (await getCollection('reflections')).map((post) => ({
  ...post,
  collectionName: 'reflections',
}));

const allPosts = [
  ...psychologyPosts,
  ...philosophyPosts,
  ...reflectionsPosts,
];

const sortedPosts = allPosts.sort(
  (a, b) =>
    new Date(b.data.pubDate).valueOf() -
    new Date(a.data.pubDate).valueOf(),
);

const categoryLabels: Record<string, string> = {
  psychology: 'Psychology',
  philosophy: 'Philosophy',
  reflections: 'Reflections',
};
---

<Layout title="Home">
  <section class="max-w-3xl mx-auto px-6 sm:px-8 py-20 sm:py-28">
    <header
      class="mb-24 relative pl-6 sm:pl-8 border-l-[1.5px] border-gray-200 dark:border-gray-800"
    >
      <blockquote class="space-y-4">
        <p
          class="text-2xl sm:text-3xl font-serif text-gray-900 dark:text-gray-100 leading-normal tracking-wide"
        >
          우리는 종종 정답을 찾으려 밤을 헤매지만,
        </p>

        <p
          class="text-lg sm:text-xl font-serif text-gray-500 dark:text-gray-400 leading-relaxed tracking-wide"
        >
          때로는 좋은 질문 하나를 남기는 것만으로도
          <br class="hidden sm:block" />
          충분한 밤이 있습니다.
        </p>
      </blockquote>
    </header>

    <main>
      <h2
        class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-8"
      >
        Recent Writings
      </h2>

      <ul class="space-y-12">
        {
          sortedPosts.map((post) => (
            <li class="group">
              <a
                href={`/${post.collectionName}/${post.id}`}
                class="block"
              >
                <div
                  class="
                    grid grid-cols-[1fr_auto]
                    sm:grid-cols-[7rem_minmax(0,1fr)_auto]
                    items-baseline
                    gap-x-4 sm:gap-x-6
                    gap-y-2
                  "
                >
                  <span
                    class="
                      col-start-1 row-start-1
                      text-xs sm:text-sm
                      font-medium font-sans
                      text-blue-600 dark:text-blue-400
                      tracking-wide
                    "
                  >
                    {categoryLabels[post.collectionName]}
                  </span>

                  <h3
                    class="
                      col-span-2 row-start-2
                      sm:col-span-1 sm:col-start-2 sm:row-start-1
                      text-lg sm:text-xl
                      font-medium font-sans
                      text-gray-800 dark:text-gray-200
                      group-hover:text-black
                      dark:group-hover:text-white
                      transition-colors duration-200
                      tracking-tight
                    "
                  >
                    {post.data.title}
                  </h3>

                  <time
                    class="
                      col-start-2 row-start-1
                      sm:col-start-3
                      text-xs sm:text-sm
                      font-sans
                      text-gray-400 dark:text-gray-500
                      whitespace-nowrap
                    "
                  >
                    {new Date(post.data.pubDate)
                      .toLocaleDateString('ko-KR', {
                        year: 'numeric',
                        month: '2-digit',
                        day: '2-digit',
                      })
                      .replace(/\.$/, '')}
                  </time>

                  {
                    post.data.description && (
                      <p
                        class="
                          col-span-2 row-start-3
                          sm:col-start-2 sm:col-span-2 sm:row-start-2
                          text-sm sm:text-base
                          font-sans
                          font-normal
                          text-gray-500 dark:text-gray-400
                          leading-relaxed
                          line-clamp-2
                        "
                      >
                        {post.data.description}
                      </p>
                    )
                  }
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </section>
</Layout>