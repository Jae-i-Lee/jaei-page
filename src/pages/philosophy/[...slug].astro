---
import DatabasePostArticle from "@/components/blog/DatabasePostArticle.astro";
import NotFoundPage from "@/components/NotFoundPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getPostRedirect,
  getPublishedPost,
  renderPostMarkdown,
} from "@/lib/blog";

export const prerender = false;

const slug = Astro.params.slug ?? "";
const post =
  slug && !slug.includes("/")
    ? await getPublishedPost("philosophy", slug)
    : null;

if (!post && slug) {
  const redirect = await getPostRedirect("philosophy", slug);
  if (redirect) {
    return Astro.redirect(
      `/${redirect.targetCategory}/${encodeURIComponent(redirect.targetSlug)}`,
      301,
    );
  }
}

if (!post) Astro.response.status = 404;
const html = post ? renderPostMarkdown(post.body) : "";
---

{
  post ? (
    <DatabasePostArticle {post} {html} />
  ) : (
    <BaseLayout metadata={{ title: "페이지를 찾을 수 없습니다" }}>
      <NotFoundPage />
    </BaseLayout>
  )
}
