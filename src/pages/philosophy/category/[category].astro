---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { listPublishedPosts } from "@/lib/blog";
import Headline from "@/components/ui/Headline.astro";
import PostItem from "@/components/blog/DatabasePostItem.astro";

export async function getStaticPaths() {
  const posts = await listPublishedPosts("philosophy");

  const categories = new Set();
  posts.forEach((post) => {
    if (post.category) {
      categories.add(
        post.category.charAt(0).toUpperCase() + post.category.slice(1),
      );
    }
  });

  return Array.from(categories).map((category) => {
    return {
      params: { category: category as string },
      props: {
        category,
        posts: posts.filter(
          (post) => post.category === String(category).toLowerCase(),
        ),
      },
    };
  });
}

const { category, posts } = Astro.props;

const metadata = {
  title: `${category} · Philosophy`,
  description: `${category} 분류의 철학 글을 모았습니다.`,
};
---

<BaseLayout metadata={metadata}>
  <section class="px-6 py-16 sm:px-8 sm:py-24">
    <div class="mx-auto max-w-3xl">
      <Headline
        tagline="Category"
        title={category}
        subtitle={`${posts.length}개의 글`}
        classes={{
          container: "mb-12 border-l border-border pl-6 sm:pl-8",
          title:
            "mb-4 font-sans text-3xl font-bold tracking-tight text-foreground md:text-4xl",
          subtitle: "text-base text-muted-foreground",
          tagline: "px-0 py-0 text-xs uppercase tracking-[0.2em]",
        }}
        titleAs="h1"
      />

      <div class="mb-10">
        <a
          href="/philosophy"
          class="text-sm text-primary transition-opacity hover:opacity-70"
          >← Philosophy로 돌아가기</a
        >
      </div>

      <div>
        {
          posts
            .sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf())
            .map((post) => <PostItem post={post} />)
        }
      </div>
    </div>
  </section>
</BaseLayout>
